---
import ArtSlot from "./ArtSlot.astro";
import Section from "./Section.astro";
import { enterpriseUrl, site } from "~/config/site";

/**
 * "Run it on your own infrastructure": rendered only when `showEnterprise` is
 * true in the config. Off by default. The link goes to the booking page, or to
 * the support address while there is no booking page.
 */
---

{
  site.showEnterprise && (
    <Section label="Enterprise" pad="snug">
      <div class="relative overflow-hidden rounded-xl border border-border p-gutter-lg md:p-12">
        <ArtSlot name="enterprise-band" size="1600 x 900" />
        <div class="relative flex flex-col gap-gutter-lg md:flex-row md:items-center md:justify-between">
          <h2 class="type-headline max-w-[34rem]">
            Run {site.name} on your own infrastructure. Talk to us.
          </h2>
          <a href={enterpriseUrl} class="btn btn-outline shrink-0">
            Talk to us
          </a>
        </div>
      </div>
    </Section>
  )
}
