---
import { site } from "~/config/site";

/**
 * The wordmark. Both files ship; CSS picks the one for the current surface via
 * a token, so the right one is showing before any script runs. The wordmark is
 * never a heading.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={["inline-block", className]}>
  <img
    class="on-dark h-full w-auto"
    src={site.logo.dark}
    alt={site.logo.alt}
    width="680"
    height="200"
    decoding="async"
  />
  <img
    class="on-light h-full w-auto"
    src={site.logo.light}
    alt={site.logo.alt}
    width="680"
    height="200"
    decoding="async"
  />
</span>
