---
/**
 * Questions as native disclosures: keyboard and screen-reader behaviour comes
 * from <details>, with no script. The answers are plain text, supplied by the
 * page, so every figure in them can come from the config.
 */
interface Props {
  items: readonly { readonly question: string; readonly answer: string }[];
}

const { items } = Astro.props;
---

<div class="ruled faq">
  {
    items.map((item) => (
      <details>
        <summary>
          <span class="question">{item.question}</span>
          <span class="mark" aria-hidden="true" />
        </summary>
        <p class="type-body measure mt-3 text-muted-foreground">{item.answer}</p>
      </details>
    ))
  }
</div>

<style>
  /* The row itself carries the rules; the summary is the 44px target. */
  .faq > details {
    padding-block: 0.25rem;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius-sm);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .question {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  summary:hover .question {
    color: var(--signal-text);
  }

  /* A plus that becomes a minus: two bars, one of which turns away. */
  .mark {
    position: relative;
    flex: none;
    width: 0.875rem;
    height: 0.875rem;
  }

  .mark::before,
  .mark::after {
    content: "";
    position: absolute;
    inset: 50% 0 auto;
    height: 2px;
    margin-top: -1px;
    background: var(--muted-foreground);
    transition: transform 140ms var(--ease-rail);
  }

  .mark::after {
    transform: rotate(90deg);
  }

  details[open] .mark::after {
    transform: rotate(0deg);
  }

  details > p {
    padding-bottom: 0.75rem;
  }
</style>
