---
import SignalLamp from "./SignalLamp.astro";

/**
 * Marks a legal page as a draft that has not been reviewed. Uses the caution
 * aspect, with its word, because that is exactly what it is: needs attention.
 */
interface Props {
  /** The draft's version, without the "v": "0.1". */
  version: string;
  /** The day it was last changed, as an ISO date: "2026-10-21". */
  updated: string;
}

const { version, updated } = Astro.props;

const updatedText = new Date(`${updated}T00:00:00Z`).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<div
  role="note"
  aria-labelledby="draft-notice-heading"
  class="card mt-gutter-lg border-caution"
>
  <SignalLamp aspect="caution" word={`Draft v${version}`} />
  <h2 id="draft-notice-heading" class="type-title mt-3">
    Draft — last updated <time datetime={updated}>{updatedText}</time>
  </h2>
  <p class="type-body measure mt-2 text-muted-foreground">
    A first draft, written from how the product works today. It has not been
    reviewed by a lawyer and is not in force yet.
  </p>
</div>
