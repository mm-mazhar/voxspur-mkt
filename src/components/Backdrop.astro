---
import ArtSlot from "./ArtSlot.astro";

/**
 * The ambient backdrop behind a hero or a closing call to action: a dotted
 * grid, one soft glow in a corner, and an optional generated image. It runs the
 * width of the window behind the section it sits in, so that section must be
 * `relative`. See `.backdrop` in global.css.
 */
interface Props {
  corner?: "top-right" | "bottom-right" | "bottom-left";
  /** True above the fold, so the optional image is not lazy-loaded. */
  eager?: boolean;
}

const { corner = "top-right", eager = false } = Astro.props;
---

<div class="backdrop" data-corner={corner} aria-hidden="true">
  <ArtSlot name="ambient-backdrop" size="1920 x 1080" eager={eager} />
</div>
