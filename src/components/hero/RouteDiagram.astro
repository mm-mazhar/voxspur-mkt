---
import SignalLamp from "../SignalLamp.astro";

/**
 * The hero visual: one real call path, drawn as a route.
 *
 * This component is the whole visual. The hero holds it in a slot, so a later
 * version can swap in another visual (a 3D scene as an island, say) without
 * touching the hero's copy or layout.
 *
 * Two layouts of the same route are drawn: left to right on wide screens, top
 * to bottom on narrow ones. Only one is in the document at a time, so only one
 * is read aloud. Every shape takes its fill or stroke from a token.
 *
 * Geometry: straight runs, 12px arcs, branches leaving at 45 degrees. The main
 * route is Signal Green; the branch takes the next line colour.
 */

const description =
  "A call travelling one route: the caller rings, the agent greets them, the agent qualifies them, and then the call is either booked or transferred to a person before it ends.";

interface Stop {
  readonly name: string;
  /** How far into the call this stop is. */
  readonly at: string;
  readonly x: number;
  readonly y: number;
  /** The end of the route, drawn filled. */
  readonly terminus?: boolean;
}

/* -- Wide layout: main route runs along y = 120 from x = 70 to x = 880. --- */
const wideStops: readonly Stop[] = [
  { name: "Caller rings", at: "0:00", x: 70, y: 120 },
  { name: "Agent greets", at: "0:02", x: 270, y: 120 },
  { name: "Qualifies", at: "0:11", x: 470, y: 120 },
  { name: "Books", at: "0:48", x: 670, y: 120 },
  { name: "Call ends", at: "1:05", x: 880, y: 120, terminus: true },
];

const wideMainPath = "M 70 120 H 880";

/* The branch leaves the main line after the third stop, drops 45 degrees
   through a 12px arc, runs parallel at y = 220, then climbs back to the
   terminus. The arc and diagonal offsets are worked out once. */
const wideBranchPath = [
  "M 500 120",
  "a 12 12 0 0 1 8.49 3.51",
  "l 92.97 92.98",
  "a 12 12 0 0 0 8.49 3.51",
  "h 150",
  "a 12 12 0 0 0 8.49 -3.51",
  "l 92.97 -92.98",
  "a 12 12 0 0 1 8.49 -3.51",
  "H 880",
].join(" ");

const wideBranchStop: Stop = {
  name: "Transfer to a person",
  at: "0:52",
  x: 684.95,
  y: 220,
};

/* -- Narrow layout: main route runs down x = 44 from y = 48 to y = 568. ---- */
const narrowStops: readonly Stop[] = [
  { name: "Caller rings", at: "0:00", x: 44, y: 48 },
  { name: "Agent greets", at: "0:02", x: 44, y: 178 },
  { name: "Qualifies", at: "0:11", x: 44, y: 308 },
  { name: "Books", at: "0:48", x: 44, y: 438 },
  { name: "Call ends", at: "1:05", x: 44, y: 568, terminus: true },
];

const narrowMainPath = "M 44 48 V 568";

const narrowBranchPath = [
  "M 44 338",
  "a 12 12 0 0 0 3.51 8.49",
  "l 60.98 60.98",
  "a 12 12 0 0 1 3.51 8.49",
  "v 60",
  "a 12 12 0 0 1 -3.51 8.49",
  "l -60.98 60.98",
  "a 12 12 0 0 0 -3.51 8.49",
  "V 568",
].join(" ");

const narrowBranchStop: Stop = {
  name: "Transfer to a person",
  at: "0:52",
  x: 112,
  y: 446,
};
---

<figure id="hero-figure" data-route-state="running" class="mt-gutter-lg mb-0">
  <div
    id="hero-route"
    class="rounded-xl border border-border bg-card p-gutter-sm sm:p-gutter-md"
  >
    {/* ------------------------------ wide ------------------------------ */}
    <div class="scroll-x hidden md:block">
      <svg
        role="img"
        viewBox="0 0 950 300"
        class="h-auto w-full min-w-[640px]"
        style="--route-length: 810;"
      >
        <title>{description}</title>

        {/* The branch: transfer to a person. The next line colour. */}
        <path
          d={wideBranchPath}
          fill="none"
          stroke="var(--line-2)"
          stroke-width="2"
          stroke-linecap="round"
          class="route-line"
          style="--route-length: 452;"
        />

        {/* The main route. */}
        <path
          d={wideMainPath}
          fill="none"
          stroke="var(--line-1)"
          stroke-width="2"
          stroke-linecap="round"
          class="route-line"
        />

        {/* The branch stop. */}
        <g class="route-stop" style="--stop-index: 3;">
          <circle
            cx={wideBranchStop.x}
            cy={wideBranchStop.y}
            r="6"
            fill="var(--card)"
            stroke="var(--line-2)"
            stroke-width="2"></circle>
        </g>
        <text
          x={wideBranchStop.x}
          y={wideBranchStop.y + 30}
          text-anchor="middle"
          fill="var(--muted-foreground)"
          class="type-label"
          style="font-size: 11px; letter-spacing: 0.1em;"
        >
          {wideBranchStop.name.toUpperCase()}
        </text>
        <text
          x={wideBranchStop.x}
          y={wideBranchStop.y + 48}
          text-anchor="middle"
          fill="var(--muted-foreground)"
          class="type-figure"
          style="font-size: 11px;"
        >
          {wideBranchStop.at}
        </text>

        {/* The stops on the main route. The terminus is filled. */}
        {
          wideStops.map((stop, index) => (
            <g>
              <g class="route-stop" style={`--stop-index: ${index};`}>
                <circle
                  cx={stop.x}
                  cy={stop.y}
                  r="6"
                  fill={stop.terminus ? "var(--line-1)" : "var(--card)"}
                  stroke="var(--line-1)"
                  stroke-width="2"
                />
              </g>
              <text
                x={stop.x}
                y={stop.y - 28}
                text-anchor="middle"
                fill="var(--foreground)"
                class="type-label"
                style="font-size: 11px; letter-spacing: 0.1em;"
              >
                {stop.name.toUpperCase()}
              </text>
              <text
                x={stop.x}
                y={stop.y - 12}
                text-anchor="middle"
                fill="var(--muted-foreground)"
                class="type-figure"
                style="font-size: 11px;"
              >
                {stop.at}
              </text>
            </g>
          ))
        }

        {/* The travelling dot. The main route is straight, so it moves on x. */}
        <circle
          cx="70"
          cy="120"
          r="5"
          fill="var(--signal)"
          class="route-dot route-dot-wide"
          aria-hidden="true"></circle>
      </svg>
    </div>

    {/* ----------------------------- narrow ----------------------------- */}
    <div class="md:hidden">
      <svg
        role="img"
        viewBox="0 0 320 620"
        class="h-auto w-full"
        style="--route-length: 520;"
      >
        <title>{description}</title>

        <path
          d={narrowBranchPath}
          fill="none"
          stroke="var(--line-2)"
          stroke-width="2"
          stroke-linecap="round"
          class="route-line"
          style="--route-length: 286;"
        />

        <path
          d={narrowMainPath}
          fill="none"
          stroke="var(--line-1)"
          stroke-width="2"
          stroke-linecap="round"
          class="route-line"
        />

        <g class="route-stop" style="--stop-index: 3;">
          <circle
            cx={narrowBranchStop.x}
            cy={narrowBranchStop.y}
            r="6"
            fill="var(--card)"
            stroke="var(--line-2)"
            stroke-width="2"></circle>
        </g>
        <text
          x={narrowBranchStop.x + 16}
          y={narrowBranchStop.y + 4}
          fill="var(--muted-foreground)"
          class="type-label"
          style="font-size: 10px; letter-spacing: 0.08em;"
        >
          {narrowBranchStop.name.toUpperCase()}
        </text>

        {
          narrowStops.map((stop, index) => (
            <g>
              <g class="route-stop" style={`--stop-index: ${index};`}>
                <circle
                  cx={stop.x}
                  cy={stop.y}
                  r="6"
                  fill={stop.terminus ? "var(--line-1)" : "var(--card)"}
                  stroke="var(--line-1)"
                  stroke-width="2"
                />
              </g>
              <text
                x={stop.x + 18}
                y={stop.y - 2}
                fill="var(--foreground)"
                class="type-label"
                style="font-size: 11px; letter-spacing: 0.08em;"
              >
                {stop.name.toUpperCase()}
              </text>
              <text
                x={stop.x + 18}
                y={stop.y + 14}
                fill="var(--muted-foreground)"
                class="type-figure"
                style="font-size: 11px;"
              >
                {stop.at}
              </text>
            </g>
          ))
        }

        <circle
          cx="44"
          cy="48"
          r="5"
          fill="var(--signal)"
          class="route-dot route-dot-narrow"
          aria-hidden="true"></circle>
      </svg>
    </div>
  </div>

  <figcaption
    class="mt-gutter-sm flex flex-wrap items-center justify-between gap-gutter-sm"
  >
    <span class="flex flex-wrap items-center gap-x-gutter-md gap-y-1">
      <span class="type-label text-muted-foreground">One call</span>
      <SignalLamp aspect="clear" word="Answered" />
    </span>
    <button
      type="button"
      id="route-pause"
      class="btn btn-outline h-11 px-4 text-sm"
      aria-pressed="false"
      aria-controls="hero-route"
    >
      <svg
        class="size-4"
        viewBox="0 0 16 16"
        fill="currentColor"
        aria-hidden="true"
        data-icon="pause"
      >
        <rect x="3.5" y="2.5" width="3" height="11" rx="1"></rect>
        <rect x="9.5" y="2.5" width="3" height="11" rx="1"></rect>
      </svg>
      <svg
        class="size-4"
        viewBox="0 0 16 16"
        fill="currentColor"
        aria-hidden="true"
        data-icon="play"
      >
        <path d="M4.5 2.9c0-.8.9-1.3 1.6-.9l6.3 4a1 1 0 0 1 0 1.8l-6.3 4c-.7.4-1.6-.1-1.6-.9V2.9Z"
        ></path>
      </svg>
      <span data-label>Pause</span>
    </button>
  </figcaption>
</figure>

<style>
  /* The one orchestrated moment on the site. The route draws itself once, then
     a single dot travels the main line on a slow loop. All of it is scoped to
     this component so the whole visual can be swapped out in one file. */

  /* Each line draws itself from its first stop to its last over two seconds. */
  .route-line {
    stroke-dasharray: var(--route-length);
    stroke-dashoffset: 0;
    animation: route-draw 2s var(--ease-rail) both;
  }

  /* The stops arrive along the line as it is drawn. */
  .route-stop {
    transform-box: fill-box;
    transform-origin: center;
    animation: route-stop-in 400ms var(--ease-rail) both;
    animation-delay: calc(var(--stop-index, 0) * 260ms + 250ms);
  }

  /* Both layouts use a straight main line, so a translate is all the dot
     needs and no motion path is involved. */
  .route-dot-wide {
    animation: route-travel-wide 7s linear 2.2s infinite;
  }

  .route-dot-narrow {
    animation: route-travel-narrow 7s linear 2.2s infinite;
  }

  /* The Pause control. One attribute drives the dot and the button's icon. */
  [data-route-state="paused"] .route-dot {
    animation-play-state: paused;
  }

  [data-icon="play"] {
    display: none;
  }

  [data-route-state="paused"] [data-icon="play"] {
    display: block;
  }

  [data-route-state="paused"] [data-icon="pause"] {
    display: none;
  }

  @keyframes route-draw {
    from {
      stroke-dashoffset: var(--route-length);
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes route-stop-in {
    from {
      opacity: 0;
      transform: scale(0.5);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes route-travel-wide {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(810px);
    }
  }

  @keyframes route-travel-narrow {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(520px);
    }
  }

  /* The route is drawn complete and the dot is still. */
  @media (prefers-reduced-motion: reduce) {
    .route-line,
    .route-stop,
    .route-dot {
      animation: none;
    }

    .route-line {
      stroke-dashoffset: 0;
    }

    .route-stop {
      opacity: 1;
      transform: none;
    }

    .route-dot-wide {
      transform: translateX(310px);
    }

    .route-dot-narrow {
      transform: translateY(200px);
    }
  }
</style>

<script>
  const figure = document.getElementById("hero-figure");
  const button = document.getElementById("route-pause");
  const label = button?.querySelector<HTMLElement>("[data-label]");

  button?.addEventListener("click", () => {
    if (!figure) return;
    const paused = figure.dataset.routeState !== "paused";
    figure.dataset.routeState = paused ? "paused" : "running";
    button.setAttribute("aria-pressed", String(paused));
    if (label) label.textContent = paused ? "Play" : "Pause";
  });
</script>
