---
import Container from "~/components/Container.astro";
import Footer from "~/components/Footer.astro";
import Header from "~/components/Header.astro";
import MotionToggle from "~/components/MotionToggle.astro";
import { site } from "~/config/site";
import "~/styles/global.css";

interface Props {
  /** Names the page. The product name is appended from the config. */
  title: string;
  /** One sentence. */
  description: string;
  /** Required before taking customers, but not for search engines. */
  noindex?: boolean;
  /** True on a page with decorative motion: shows the pause control, fixed at the bottom left. */
  motion?: boolean;
}

const { title, description, noindex = false, motion = false } = Astro.props;

const pageTitle = `${title} · ${site.name}`;

// Share address and share image, as absolute links. The image tags are written
// only once the file is in src/assets, so a preview never points at a 404.
const pageUrl = new URL(Astro.url.pathname, site.siteUrl).toString();
const ogFiles = import.meta.glob<{ default: ImageMetadata }>("/src/assets/og-card.{png,jpg}", {
  eager: true,
});
const ogImage = Object.values(ogFiles)[0]?.default;
const ogImageUrl = ogImage ? new URL(ogImage.src, site.siteUrl).toString() : undefined;
const ogImageAlt = `${site.name}: ${site.tagline}`;

if (ogImage && (ogImage.width !== site.ogImage.width || ogImage.height !== site.ogImage.height)) {
  console.warn(
    `og-card is ${ogImage.width} x ${ogImage.height}; link previews expect ${site.ogImage.width} x ${site.ogImage.height}.`,
  );
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* The two display faces are needed for the first paint of every page. */}
    <link
      rel="preload"
      href="/fonts/archivo-latin-wdth.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/geist-latin-wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={pageUrl} />
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:image:width" content={String(ogImage.width)} />
          <meta property="og:image:height" content={String(ogImage.height)} />
          <meta property="og:image:alt" content={ogImageAlt} />
          <meta name="twitter:image" content={ogImageUrl} />
        </>
      )
    }

    {/*
      Applies a remembered theme before the first paint, so the page never
      flashes the wrong one. With no stored choice the page follows the system,
      and the stylesheet defaults to dark.
    */}
    <script is:inline>
      (function () {
        try {
          var choice = localStorage.getItem("site-theme");
          if (choice === "light" || choice === "dark") {
            document.documentElement.setAttribute("data-theme", choice);
          }
        } catch (error) {
          /* Storage blocked. The stylesheet default stands. */
        }
      })();
    </script>
  </head>

  <body>
    <a
      href="#main"
      class="btn btn-primary sr-only focus-visible:not-sr-only focus-visible:absolute focus-visible:top-3 focus-visible:left-3 focus-visible:z-60"
    >
      Skip to content
    </a>

    <Header />
    {motion && <MotionToggle />}

    <main id="main">
      <Container>
        {/* The line. Decoration: the page reads correctly without it. */}
        <div class="rail">
          <div class="rail-line" aria-hidden="true"></div>
          <slot />
        </div>
      </Container>
    </main>

    {/* Room under the footer so the fixed pause control never covers its last line. */}
    <div class={motion ? "pb-[4.5rem]" : undefined}>
      <Footer />
    </div>
  </body>
</html>
