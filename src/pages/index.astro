---
import Interchange from "~/components/Interchange.astro";
import Section from "~/components/Section.astro";
import Hero from "~/components/hero/Hero.astro";
import RouteDiagram from "~/components/hero/RouteDiagram.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { signupUrl, site } from "~/config/site";

/** What the product does today. Nothing here is a plan. */
const capabilities = [
  {
    label: "Calls",
    title: "Inbound and outbound",
    body: "Answer calls that come in, place calls that go out, and run outbound campaigns from a list.",
  },
  {
    label: "Handover",
    title: "Transfer to a person",
    body: "The agent can hand a call to someone on your team, with a spoken handover first if you want one.",
  },
  {
    label: "Tools",
    title: "Act during the call",
    body: "Give the agent tools it can call mid-conversation, so it can look something up or write something down while the caller is still on the line.",
  },
  {
    label: "Knowledge",
    title: "A knowledge base",
    body: "Upload documents and the agent answers from them during a call.",
  },
  {
    label: "Web",
    title: "A widget for your site",
    body: "Put the same agent on a web page, so visitors can talk to it without dialling.",
  },
  {
    label: "Records",
    title: "Recordings and transcripts",
    body: "Every run is kept with its recording, its transcript and its history, so you can hear what happened.",
  },
  {
    label: "Keys",
    title: "Bring your own",
    body: "Use your own accounts for the language model, the voice and the transcriber, and your own embeddings key for the knowledge base. You keep the relationship and the bill.",
  },
];

/** The order here is real, so the stops are numbered. */
const steps = [
  {
    order: "01",
    name: "Describe the agent",
    body: "Write what the agent should do, in plain language: how it opens, what it needs to find out, when it should book and when it should hand over.",
  },
  {
    order: "02",
    name: "Connect a number",
    body: "Bring a number from Twilio, Telnyx, Plivo, Exotel or Cloudonix, or point your own SIP at it through Asterisk.",
  },
  {
    order: "03",
    name: "Test the call",
    body: "Talk to the agent yourself before anyone else does. Change the wording, run it again, and listen to the recording.",
  },
];

const connections = [
  {
    label: "Phone numbers",
    body: "Twilio, Telnyx, Plivo, Exotel and Cloudonix. Or your own SIP, through Asterisk.",
  },
  {
    label: "Language models",
    body: "Your own key, your own account, your own choice of model.",
  },
  {
    label: "Voices",
    body: "Your own key for the voice you want the agent to speak in.",
  },
  {
    label: "Transcribers",
    body: "Your own key for the service that turns the caller into text.",
  },
  {
    label: "People",
    body: "A transfer to a person on the phone, with an optional spoken handover.",
  },
  {
    label: "Websites",
    body: "A widget that puts an agent on a page of your site.",
  },
  {
    label: "Your tools",
    body: "Tools you define, which the agent can call during a conversation.",
  },
];
---

<BaseLayout title="Voice agents for phone calls" description={site.description}>
  <Hero
    heading="Voice agents that answer and place phone calls."
    lede="Describe what the agent should do, connect a phone number, and test the call in your browser. Bring your own model, voice and transcriber keys, and keep the accounts you already have."
  >
    <RouteDiagram />
  </Hero>

  <Section label="What it does">
    <h2 class="type-headline">Everything a call needs, and nothing it does not.</h2>
    <p class="type-lede measure mt-gutter-md text-muted-foreground">
      This is the whole of what the platform does today. If something is not
      listed here, it is not built yet.
    </p>

    <div class="ruled mt-gutter-lg">
      {
        capabilities.map((item) => (
          <div class="grid gap-x-gutter-lg gap-y-2 md:grid-cols-[10rem_minmax(0,1fr)]">
            <p class="type-label text-muted-foreground md:pt-1">{item.label}</p>
            <div class="min-w-0">
              <h3 class="type-title">{item.title}</h3>
              <p class="type-body measure mt-1 text-muted-foreground">{item.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <Section label="How to go live">
    <h2 class="type-headline">Three steps to a working agent.</h2>
    <p class="type-lede measure mt-gutter-md text-muted-foreground">
      In that order. You can hear the agent before you give anyone the number.
    </p>

    <ol class="mt-gutter-lg grid gap-gutter-lg md:grid-cols-3">
      {
        steps.map((step, index) => (
          <li class="relative min-w-0">
            {/* The run of line between this stop and the next. */}
            {index < steps.length - 1 && (
              <span
                class="absolute top-[6px] left-[1.4rem] hidden h-rail w-[calc(100%+0.6rem)] bg-border md:block"
                aria-hidden="true"
              />
            )}
            <span
              class:list={[
                "stop-marker relative z-10",
                index === 0 && "stop-marker-filled",
              ]}
              aria-hidden="true"
            />
            <p class="type-label mt-gutter-md text-muted-foreground">
              <span class="type-figure text-signal-text">{step.order}</span>
              <span aria-hidden="true"> · </span>
              {step.name}
            </p>
            <p class="type-body mt-3 text-muted-foreground">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section label="What it connects to">
    <h2 class="type-headline">It sits between the phone and the providers you bring.</h2>
    <p class="type-lede measure mt-gutter-md text-muted-foreground">
      The platform does not resell models, voices or numbers. You connect the
      accounts you already have, and it runs the call between them.
    </p>

    <div class="mt-gutter-lg">
      <Interchange />
    </div>

    <div class="scroll-x mt-gutter-lg">
      <table class="timetable min-w-[32rem]">
        <caption class="sr-only">What the platform connects to today</caption>
        <thead>
          <tr>
            <th scope="col">Connects to</th>
            <th scope="col">What that means</th>
          </tr>
        </thead>
        <tbody>
          {
            connections.map((row) => (
              <tr>
                <th scope="row" class="type-label align-top font-normal">
                  {row.label}
                </th>
                <td class="type-body text-muted-foreground">{row.body}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </Section>

  <Section label="Next stop" filled>
    <h2 class="type-headline">Build the first agent.</h2>
    <p class="type-lede measure mt-gutter-md text-muted-foreground">
      Describe it, give it a number, and call it yourself. You pay the platform
      fee and your own providers, and nothing else.
    </p>
    <div class="mt-gutter-lg flex flex-wrap items-center gap-3">
      <a href={signupUrl} class="btn btn-primary">Get started</a>
      <a href="/pricing" class="btn btn-outline">See pricing</a>
    </div>
  </Section>
</BaseLayout>
