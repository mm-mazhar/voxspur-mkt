---
import CoreFeatures from "~/components/CoreFeatures.astro";
import EnterpriseBand from "~/components/EnterpriseBand.astro";
import Faq from "~/components/Faq.astro";
import FinalCta from "~/components/FinalCta.astro";
import IntegrationsMarquee from "~/components/IntegrationsMarquee.astro";
import PartnerBand from "~/components/PartnerBand.astro";
import PricingBand from "~/components/PricingBand.astro";
import Section from "~/components/Section.astro";
import UseCaseTabs from "~/components/UseCaseTabs.astro";
import Hero from "~/components/hero/Hero.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import {
  formatMinimumCallBalance,
  formatPriceRate,
  joinNames,
  liveTelephonyNames,
  site,
} from "~/config/site";

/** The hero's headline, split for two lines. The closing call to action repeats it. */
const heading = ["Voice agents that answer", "and place phone calls."] as const;

/** The order here is real, so the stops are numbered. */
const steps = [
  {
    order: "01",
    name: "Build the agent",
    body: "Lay the call out in the visual builder: how it opens, what it asks, when it books and when it hands over to a person.",
  },
  {
    order: "02",
    name: "Connect your number",
    body: `Connect a phone number through ${joinNames(liveTelephonyNames())}.`,
  },
  {
    order: "03",
    name: "Go live and review every call",
    body: "Test the call in your browser, then switch it on. Every call is recorded and transcribed, so you can listen back and read what was said.",
  },
];

const faq = [
  {
    question: "What does it cost?",
    answer: `${formatPriceRate()} for the platform, charged by the second against prepaid credit. You pay your own model, voice and phone providers directly. There is no subscription.`,
  },
  {
    question: "What do I need to bring?",
    answer: `Your own accounts: a language model, a voice and a transcriber, plus an embeddings key if you use the knowledge base. For phone calls you connect a number through ${joinNames(liveTelephonyNames())}.`,
  },
  {
    question: "What happens when my credit runs out?",
    answer: `Turn on automatic top-up and credit is added for you, so calls do not stop for lack of balance. A call needs a balance of at least ${formatMinimumCallBalance()} to start.`,
  },
  {
    question: "Can I test an agent before it takes real calls?",
    answer: "Yes. Call it from your browser as many times as you like before you connect a number.",
  },
  {
    question: "Can the agent hand a call to a person?",
    answer:
      "Yes. It can transfer the call to someone on your team, with a spoken handover first if you want one.",
  },
  {
    question: "What can the knowledge base read?",
    answer:
      "PDFs with selectable text, Word .docx files, plain text, Markdown and JSON. It does not read scanned documents, photos of pages, legacy .doc files or password-protected PDFs.",
  },
  {
    question: "Can I see what happened on a call?",
    answer: "Every call has its recording, its transcript and its run history.",
  },
  {
    question: "Can my team share one account?",
    answer: "Yes. Workspaces have owner, admin and member roles.",
  },
  {
    question: "Can I put an agent on my website?",
    answer: "Yes. A widget puts the same agent on a page of your site, so visitors can talk to it without dialling.",
  },
  {
    question: "Do you make outbound calls?",
    answer:
      "Yes, one at a time or as a campaign from a list. You are responsible for getting consent, calling only within permitted hours, and honouring opt-outs. Tools for consent records, calling hours and opt-out handling are coming soon.",
  },
];
---

<BaseLayout title="Voice agents for phone calls" description={site.description} motion>
  <Hero
    heading={heading}
    lede="Describe the agent, connect a phone number, and test the call in your browser."
  />

  <Section label="Works with" pad="snug">
    <h2 class="type-headline">Bring the providers you already use.</h2>
    <p class="type-lede measure mt-gutter-md text-muted-foreground">
      {`Connect your own accounts for models, voices, transcription and phone numbers. ${site.name} runs the call between them.`}
    </p>
    <div class="mt-gutter-lg">
      <IntegrationsMarquee />
    </div>
  </Section>

  <Section label="Core features" pad="snug">
    <h2 class="type-headline">Everything a call needs, and nothing it does not.</h2>
    <p class="type-lede measure mt-gutter-md mb-gutter-lg text-muted-foreground">
      What works today is listed first. What is on the way is marked.
    </p>
    <CoreFeatures />
  </Section>

  <Section label="How it works" pad="snug">
    <h2 class="type-headline">Three steps to a working agent.</h2>

    <ol class="steps mt-gutter-lg">
      {
        steps.map((step, index) => (
          <li class="step">
            <span
              class:list={["stop-marker", index === 0 && "stop-marker-filled"]}
              aria-hidden="true"
            />
            <p class="type-label step-name text-muted-foreground">
              <span class="type-figure text-signal-text">{step.order}</span>
              <span aria-hidden="true"> · </span>
              {step.name}
            </p>
            <p class="type-body mt-3 text-muted-foreground">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section label="Use cases" pad="snug">
    <h2 class="type-headline">Common jobs for a voice agent.</h2>
    <div class="mt-gutter-lg">
      <UseCaseTabs />
    </div>
  </Section>

  <PricingBand />
  <PartnerBand />
  <EnterpriseBand />

  <Section label="FAQ" pad="snug">
    <h2 class="type-headline">Common questions.</h2>
    <div class="mt-gutter-lg">
      <Faq items={faq} />
    </div>
  </Section>

  <FinalCta heading={heading} />
</BaseLayout>

<style>
  /* One line joins the three stops: down the side on a narrow screen, across
     the top from 768px. Either way the line is decoration. */
  .steps {
    display: grid;
    gap: 0;
    list-style: none;
    padding: 0;
  }

  .step {
    position: relative;
    min-width: 0;
    padding-left: 2.25rem;
    padding-bottom: 2rem;
  }

  .step:last-child {
    padding-bottom: 0;
  }

  .step .stop-marker {
    position: absolute;
    left: 0;
    top: 0.125rem;
    z-index: 1;
  }

  .step:not(:last-child)::before {
    content: "";
    position: absolute;
    left: 6px;
    top: 1.25rem;
    bottom: -0.125rem;
    width: var(--spacing-rail);
    background: var(--border);
  }

  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--spacing-gutter-lg);
    }

    .step {
      padding: 0;
    }

    .step .stop-marker {
      position: relative;
      top: 0;
    }

    /* The run of line from this stop to the next. */
    .step:not(:last-child)::before {
      left: 1.4rem;
      top: 6px;
      bottom: auto;
      width: calc(100% + 0.6rem);
      height: var(--spacing-rail);
    }

    .step-name {
      margin-top: var(--spacing-gutter-md);
    }
  }
</style>
