---
import DraftNotice from "~/components/DraftNotice.astro";
import LegalSection from "~/components/LegalSection.astro";
import PageHeader from "~/components/PageHeader.astro";
import Section from "~/components/Section.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { hasBookCall, site, supportEmailUrl } from "~/config/site";

const version = "0.2";
const updated = "2026-10-29";

// Before this page ships, the site owner still has to supply (kept here, not
// shown on the page):
//  - The legal entity name, its registered address and the country it is registered in.
//  - The hosting provider's name, and the regions where data is stored.
//  - Which privacy laws apply (UK GDPR, EU GDPR, CCPA or others), and the rights and transfer wording they require.
//  - How long billing records are kept, and any fixed retention period for other data.
//  - The app can send errors to Sentry and events to PostHog when their keys are set. If either is switched on, it must be listed here first.

const name = site.name;

// The "Booking a call" section is written for one provider, Cal.com, and shows
// only while the config says Cal.com is behind the booking link. It does not
// look at the link's address, which may be our own (a redirect to Cal.com). For
// any other provider, or none, it is hidden: rewrite the section for that
// provider first, then change `bookCallProvider` in the config.
const showBookingSection = hasBookCall && site.bookCallProvider === "cal.com";
---

<BaseLayout
  title="Privacy"
  description="How the site and the hosted product handle personal data. This page is a first draft awaiting review."
  noindex
>
  <PageHeader
    label="Privacy"
    heading="Privacy"
    lede="How this website and the hosted product handle personal data."
  >
    <DraftNotice version={version} updated={updated} />
  </PageHeader>

  <Section label="The policy" filled>
    <div class="ruled">
      <LegalSection heading="Who we are">
        <p>
          {`${name} is a hosted platform for building AI voice agents that answer and place phone calls. This policy covers this website and the product. Questions go to `}<a href={supportEmailUrl} class="link">{site.supportEmail}</a>.
        </p>
      </LegalSection>

      <LegalSection heading="This website">
        <p>
          The website loads no third-party scripts and sets no analytics or
          advertising cookies. Fonts are served from the site itself. The only
          thing stored in your browser is your light or dark choice, which
          stays on your device and is never sent anywhere.
        </p>
      </LegalSection>

      {
        showBookingSection && (
          <LegalSection heading="Booking a call">
            <p>
              If you book a call, you leave our site for Cal.com, which handles
              the booking under{" "}
              <a href={site.bookCallProviderPrivacyUrl} class="link">
                its own privacy policy
              </a>
              . We receive the name, email address and answers you enter, and
              use them only to prepare for and hold the call. We delete them on
              request.
            </p>
          </LegalSection>
        )
      }

      <LegalSection heading="What we collect">
        <p>When you use the product we hold:</p>
        <ul>
          <li>your account email address and how you sign in;</li>
          <li>your workspace: its name, members, roles, settings and the provider keys you connect;</li>
          <li>the agents you build: their instructions, settings and tools;</li>
          <li>call recordings, transcripts and the history of each call, including the phone numbers involved;</li>
          <li>files you upload to the knowledge base;</li>
          <li>billing records: top-ups, charges, refunds and your balance.</li>
        </ul>
        <p>Card details stay with Stripe. We never see your full card number.</p>
      </LegalSection>

      <LegalSection heading="People your agents talk to">
        <p>
          Recordings and transcripts are of the people your agents speak with.
          We hold them for you as part of your workspace. You decide whether
          calls are recorded, and you are responsible for telling people and
          getting their consent where the law requires it.
        </p>
      </LegalSection>

      <LegalSection heading="Who processes it">
        <ul>
          <li>Stripe takes payments for top-ups.</li>
          <li>Resend sends account email, such as sign-in and confirmation emails, invitations and billing notices.</li>
          <li>Google signs you in, if you choose to sign in with Google. We receive your email address from it.</li>
          <li>Our hosting provider runs the service and stores its data.</li>
          <li>The AI and telephony providers you pick, with your own keys, receive call audio, transcripts, your agents' instructions and the text of knowledge base files. They handle it under your agreements with them, not ours.</li>
        </ul>
      </LegalSection>

      <LegalSection heading="What we don't do">
        <p>
          We do not sell your data or anyone else's, and we do not use it for
          advertising. The website has no tracking.
        </p>
      </LegalSection>

      <LegalSection heading="Keeping and deleting data">
        <p>
          We keep your data while your account is open. To have it deleted,
          email us from your account address. We delete your account, and the
          workspaces you own with their agents, recordings, transcripts and
          files. Billing records are kept for as long as tax and accounting law
          requires.
        </p>
        <p>
          Data already sent to your own providers is held by them. Ask them to
          delete it.
        </p>
      </LegalSection>

      <LegalSection heading="Changes">
        <p>
          When this policy changes, the version and date at the top of this page
          change with it, and we email account owners about anything that
          matters.
        </p>
      </LegalSection>

      <LegalSection heading="Contact">
        <p>
          For a question, or to ask what we hold about you or to delete it,
          email <a href={supportEmailUrl} class="link">{site.supportEmail}</a>.
        </p>
      </LegalSection>
    </div>
  </Section>
</BaseLayout>
