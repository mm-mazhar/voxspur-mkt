---
import DraftNotice from "~/components/DraftNotice.astro";
import PageHeader from "~/components/PageHeader.astro";
import Section from "~/components/Section.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { site } from "~/config/site";

/** What the site owner has to supply before this page can ship. */
const needed = [
  "The legal entity name, its registered address and the country it is registered in.",
  "A contact address for privacy questions, and whether a data protection officer is appointed.",
  "Which regimes you are claiming to meet: UK GDPR, EU GDPR, CCPA, or others.",
  "The list of sub-processors you use for the hosted product, with what each one holds and where.",
  "How long call recordings, transcripts and run history are kept, and what happens when an account is closed.",
  "Where customer data is stored and processed, and whether it leaves that region.",
  "Your lawful basis for each kind of processing, and the mechanism for any international transfer.",
  "Whether the marketing site will ever load analytics; if so, which product and what it collects.",
  "How a person exercises access, correction, deletion and portability, and how long you take to answer.",
  "How you notify customers of a breach, and within what time.",
];

/**
 * The sections a privacy policy on this product needs. The body text under
 * each is a placeholder that states the intent, not a legal claim.
 */
const sections = [
  {
    heading: "Who we are",
    body: "Placeholder. Names the legal entity behind the product, its address, and how to reach it about privacy.",
  },
  {
    heading: "What this policy covers",
    body: "Placeholder. Distinguishes the marketing site from the hosted product, because they handle different things.",
  },
  {
    heading: "What the site collects",
    body: "The marketing site loads no third-party scripts and sets no analytics or advertising cookies. Fonts are served from the site itself. The only thing stored in your browser is your light or dark choice, which stays on your device and is never sent anywhere. If that ever changes, it will be stated here before the change ships.",
  },
  {
    heading: "What the product collects",
    body: "Placeholder. Needs to cover account details, the agents a customer builds, the keys they connect, and the recordings, transcripts and run history a call produces.",
  },
  {
    heading: "Call recordings and transcripts",
    body: "Placeholder. Needs to say who owns them, how long they are kept, who can reach them, and what the customer is responsible for telling the people they call.",
  },
  {
    heading: "Providers you connect",
    body: "Placeholder. A customer brings their own model, voice, transcriber and phone providers. Needs to say plainly that content reaches those providers under the customer's own agreements with them, not ours.",
  },
  {
    heading: "Sub-processors",
    body: "Placeholder. Needs the actual list, with what each one holds and where, and how customers are told when it changes.",
  },
  {
    heading: "Where data is held",
    body: "Placeholder. Needs the regions, and the mechanism for any transfer out of them.",
  },
  {
    heading: "How long we keep it",
    body: "Placeholder. Needs a retention period per kind of data, and what happens on account closure.",
  },
  {
    heading: "Your rights",
    body: "Placeholder. Needs the rights that apply under the regimes being claimed, and how to exercise them.",
  },
  {
    heading: "Security",
    body: "Placeholder. Only describe measures that are actually in place.",
  },
  {
    heading: "Changes to this policy",
    body: "Placeholder. Needs how changes are announced and from when they apply.",
  },
  {
    heading: "Contact",
    body: "Placeholder. Needs the address for privacy questions and for rights requests.",
  },
];
---

<BaseLayout
  title="Privacy"
  description="How the site and the hosted product handle personal data. This page is a draft awaiting review."
  noindex
>
  <PageHeader
    label="Privacy"
    heading="Privacy"
    lede={`How the site and the hosted product handle personal data. ${site.name} is not yet taking customers, and this page is not finished.`}
  >
    <DraftNotice needed={needed} />
  </PageHeader>

  <Section label="The policy" filled>
    <div class="ruled">
      {
        sections.map((section) => (
          <section class="grid gap-x-gutter-lg gap-y-2 md:grid-cols-[14rem_minmax(0,1fr)]">
            <h2 class="type-title min-w-0">{section.heading}</h2>
            <p class="type-body measure min-w-0 text-muted-foreground">{section.body}</p>
          </section>
        ))
      }
    </div>
  </Section>
</BaseLayout>
