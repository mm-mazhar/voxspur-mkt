---
import FinalCta from "~/components/FinalCta.astro";
import PageHeader from "~/components/PageHeader.astro";
import Section from "~/components/Section.astro";
import SignalLamp from "~/components/SignalLamp.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import {
  formatPriceAmount,
  formatPriceRate,
  formatPriceUnit,
  formatSharePercent,
  partnerActionLabel,
  partnerIsEarlyAccess,
  planActionUrl,
  site,
} from "~/config/site";

const actionLabel = { signup: "Get started", apply: partnerActionLabel } as const;

/** What the platform fee does and does not cover. */
const whatYouPay = [
  {
    label: "Platform",
    body: "The fee above. It covers running the call: the agent, the routing, the recordings and the history.",
    paidTo: "Us",
  },
  {
    label: "Language model",
    body: "Whatever your model provider charges, on your own account and your own key.",
    paidTo: "Your provider",
  },
  {
    label: "Voice",
    body: "Whatever your voice provider charges, on your own account and your own key.",
    paidTo: "Your provider",
  },
  {
    label: "Transcriber",
    body: "Whatever your transcription provider charges, on your own account and your own key.",
    paidTo: "Your provider",
  },
  {
    label: "Phone number",
    body: "Whatever your carrier charges for the number and the minutes.",
    paidTo: "Your carrier",
  },
];
---

<BaseLayout
  title="Pricing"
  description={`A platform fee of ${formatPriceRate()}. You pay your own model, voice and phone providers directly.`}
>
  <PageHeader
    label="Pricing"
    heading="One platform fee. You keep your own provider accounts."
    lede="The fee below covers the platform and nothing else. Your model, voice, transcriber and phone providers bill you directly, on the accounts and keys you already have."
  />

  <Section label="Plans" pad="none" class="pb-section md:pb-section-lg">
    <div class="grid grid-cols-[minmax(0,1fr)] gap-gutter-lg md:grid-cols-2">
      {
        site.plans.map((plan) => (
          <div class:list={["card flex flex-col", plan.featured && "card-featured"]}>
            <h2 class="type-title">{plan.name}</h2>
            <p class="type-body mt-2 text-muted-foreground">{plan.summary}</p>

            <div class="mt-gutter-lg border-t border-border pt-gutter-md">
              {plan.figure === "price" ? (
                <p>
                  <span class="type-figure text-[2.5rem] leading-none font-medium">
                    {formatPriceAmount()}
                  </span>
                  <span class="type-label ml-2 text-muted-foreground">
                    {formatPriceUnit()}
                  </span>
                </p>
              ) : (
                <p>
                  <span class="type-figure text-[2.5rem] leading-none font-medium">
                    {formatSharePercent()}
                  </span>
                  <span class="type-label ml-2 text-muted-foreground">
                    of client fees
                  </span>
                </p>
              )}
              <p class="type-body mt-3 text-muted-foreground">
                {plan.figure === "price"
                  ? "Charged on the minutes your agents spend on calls. Your model, voice and phone providers bill you separately, direct."
                  : "Paid to you each month, on the platform fees your clients have actually paid."}
              </p>
            </div>

            <div class="mt-gutter-lg grow">
              {plan.figure === "share" && partnerIsEarlyAccess ? (
                <SignalLamp aspect="caution" word="Launching soon" />
              ) : (
                <SignalLamp aspect="clear" word="Included" />
              )}
              <ul class="ruled mt-3">
                {plan.features.map((feature) => (
                  <li class="type-body text-muted-foreground">{feature}</li>
                ))}
              </ul>
            </div>

            <a
              href={planActionUrl(plan.action)}
              class:list={[
                "btn btn-wide mt-gutter-lg",
                plan.featured ? "btn-primary" : "btn-outline",
              ]}
            >
              {actionLabel[plan.action]}
            </a>
          </div>
        ))
      }
    </div>
  </Section>

  <Section label="What you pay for">
    <h2 class="type-headline">Who bills you, and for what.</h2>
    <p class="type-lede measure mt-gutter-md text-muted-foreground">
      The platform fee is the only line that comes from us. Everything else is a
      bill from a provider you chose and hold the account with.
    </p>

    <div
      class="scroll-x mt-gutter-lg"
      tabindex="0"
      role="region"
      aria-label="Who bills you for each part of a call"
    >
      <table class="timetable timetable-stack sm:min-w-[36rem]">
        <caption class="sr-only">Who bills you for each part of a call</caption>
        <thead>
          <tr>
            <th scope="col">Part of a call</th>
            <th scope="col">What it is</th>
            <th scope="col" class="cell-figure">Billed by</th>
          </tr>
        </thead>
        <tbody>
          {
            whatYouPay.map((row) => (
              <tr>
                <th scope="row" class="type-label align-top font-normal">
                  {row.label}
                </th>
                <td class="type-body text-muted-foreground">{row.body}</td>
                <td class="cell-figure type-label align-top text-muted-foreground" data-label="Billed by">
                  {row.paidTo}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </Section>

  <Section label="Questions">
    <h2 class="type-headline">Before you ask.</h2>
    <div class="ruled measure mt-gutter-lg">
      <div>
        <h3 class="type-title">Can I use my own phone numbers?</h3>
        <p class="type-body mt-2 text-muted-foreground">
          Yes. Bring a number from Twilio, Telnyx, Plivo, Exotel or Cloudonix,
          or route your own SIP through Asterisk.
        </p>
      </div>
      <div>
        <h3 class="type-title">Do you resell models, voices or numbers?</h3>
        <p class="type-body mt-2 text-muted-foreground">
          No. You bring your own keys and your own carrier, and they bill you
          directly.
        </p>
      </div>
      <div>
        <h3 class="type-title">What does the partner program cost?</h3>
        <p class="type-body mt-2 text-muted-foreground">
          {`Nothing. Partners pay no monthly fee and earn ${formatSharePercent()} of the platform fees their clients pay. `}
          <a href="/partners" class="link">How the partner program works</a>.
        </p>
      </div>
    </div>
  </Section>

  <FinalCta heading={["Voice agents that answer", "and place phone calls."]} />
</BaseLayout>
